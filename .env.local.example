NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The built-in "Gemini 3.6 Flash" model runs directly on this key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Routes user-added (BYOK) models through the Vercel AI Gateway and backs the
# model catalog in Connections. Provided automatically via OIDC on Vercel;
# needed explicitly for local dev.
AI_GATEWAY_API_KEY=

# Encrypts users' provider API keys at rest (lib/ai/key-crypto.ts).
# Generate with: openssl rand -base64 32
MODEL_KEY_ENCRYPTION_KEY=
