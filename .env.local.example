NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The built-in "Gemini 3.6 Flash" model runs directly on this key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Encrypts users' provider API keys at rest (lib/ai/key-crypto.ts).
# Generate with: openssl rand -base64 32
MODEL_KEY_ENCRYPTION_KEY=

# LinkedIn OAuth (Connections). Create an app at linkedin.com/developers, add
# the "Sign In with LinkedIn using OpenID Connect" product, and register the
# callback URL — http://localhost:<dev port>/api/connections/linkedin/callback
# locally, plus the same path on your deployed origin.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. The redirect URI is derived from the request's own origin, which is
# right everywhere except behind a proxy whose origin isn't the public one.
# LINKEDIN_REDIRECT_URI=

# X (Twitter) OAuth (Connections). Create an app at console.x.com, set App
# permissions to "Read" (NOT "Read and write" — see the publishing constraint in
# AGENTS.md), type "Web App, Automated App or Bot", and register the callback
# URL — http://127.0.0.1:<dev port>/api/connections/x/callback locally, plus the
# same path on your deployed origin. Use the OAuth 2.0 Client ID and Secret, not
# the OAuth 1.0a "API Key and Secret" shown on the same page.
#
# Two things the console will fight you on. Its "Website URL" field rejects
# localhost outright ("Not a valid URL format") and wants a real public URL —
# anything valid does, it is not part of the flow. And its callback field
# rejects the hostname `localhost`, so the loopback IP is the only local form it
# accepts. **Browse the dev app at http://127.0.0.1:<port> to match**, rather
# than pinning X_REDIRECT_URI: the two are different cookie origins, so a flow
# started on localhost would lose its OAuth state cookie on the way back and
# fail the state check.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional, same purpose as LINKEDIN_REDIRECT_URI above.
# X_REDIRECT_URI=

# The shared secret the scheduler authenticates with (app/api/cron/publish).
# Generate with: openssl rand -base64 32
# Unset, that endpoint refuses every request rather than running open.
CRON_SECRET=

# PRESTO_ENABLE_LIVE_PUBLISH is deliberately absent from this file. It is the
# switch that lets Presto post to a real account, and it is not configuration —
# it is a deliberate act. Set it to "true" only when you mean it; anything else,
# including unset, and every publish (button and scheduler alike) is refused.
