NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The built-in "Gemini 3.6 Flash" model runs directly on this key.
GOOGLE_GENERATIVE_AI_API_KEY=

# Encrypts users' provider API keys at rest (lib/ai/key-crypto.ts).
# Generate with: openssl rand -base64 32
MODEL_KEY_ENCRYPTION_KEY=

# LinkedIn OAuth (Connections). Create an app at linkedin.com/developers, add
# the "Sign In with LinkedIn using OpenID Connect" product, and register the
# callback URL — http://localhost:<dev port>/api/connections/linkedin/callback
# locally, plus the same path on your deployed origin.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. The redirect URI is derived from the request's own origin, which is
# right everywhere except behind a proxy whose origin isn't the public one.
# LINKEDIN_REDIRECT_URI=
