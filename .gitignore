# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# figma bridge (external tool — writes exports here)
/design-sync/

# task-log guard (per-session counters, disposable)
/.claude/.task-log-state/

# python bytecode (task-log guard hook)
__pycache__/
*.pyc

# parallel-branch workflow (scripts/worktree.sh)
/.worktree
/presto-worktrees/
