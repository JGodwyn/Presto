{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/mackbook/Code/presto/.codex/hooks/main-branch-guard.py'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/mackbook/Code/presto/.codex/hooks/task-log-guard.py' post-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/mackbook/Code/presto/.codex/hooks/task-log-guard.py' session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '/Users/mackbook/Code/presto/.codex/hooks/task-log-guard.py' stop"
          }
        ]
      }
    ]
  }
}
